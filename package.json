{
  "name": "manta-zombie",
  "private": true,
  "description": "Escape de Manta Zombie: motor de rutas, simulador y mapa en vivo sobre AWS",
  "workspaces": [
    "src/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p infra && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "mapa:prueba": "tsx scripts/generar-prueba.ts",
    "synth": "npm run build && cdk synth",
    "desplegar": "npm run build && cdk deploy MantaZombie",
    "destruir": "npm run build && cdk destroy MantaZombie"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1146.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^3.2.7"
  }
}
