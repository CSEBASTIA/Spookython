# Variables para correr el motor y el simulador en local.
# En AWS no se usa este archivo: CDK inyecta las llaves desde Secrets Manager.
# Copia este archivo a .env y cambia los valores; .env nunca se sube al repo.

PUERTO=8080
AWS_REGION=us-east-1
TABLA_MUNDO=manta-mundo-local

# Llave que el simulador manda en x-api-key a POST /paso y POST /rutas
API_KEY=cambia-esta-llave

# Llave de las rutas /admin/* del simulador
ADMIN_KEY=cambia-esta-otra-llave

# Solo el simulador: dónde está el motor (en AWS es la URL de CloudFront)
URL_MOTOR=http://localhost:8080

# Solo en local. Probar el motor sin DynamoDB, con un estado del turno guardado en un archivo:
# ESTADO_ARCHIVO=data/estado-ejemplo.json
# DynamoDB Local de docker-compose:
# DYNAMO_ENDPOINT=http://localhost:8000
# Mapa base (por defecto dist/mapa.json, que copia npm run build):
# MAPA=data/prueba.json
